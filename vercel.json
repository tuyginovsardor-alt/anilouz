{
  "rewrites": [
    {
      "source": "/api-tspay/(.*)",
      "destination": "https://tspay.uz/api/v1/$1"
    },
    {
      "source": "/logo.svg",
      "destination": "/logo.svg"
    },
    {
      "source": "/logo.png",
      "destination": "/logo.png"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/((?!assets/|.*\\.(?:svg|png|jpg|jpeg|gif|ico|js|css|json|txt|xml)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(?:svg|png|jpg|json)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}