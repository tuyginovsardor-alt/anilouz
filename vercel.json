
{
  "rewrites": [
    {
      "source": "/api-tspay/:path*",
      "destination": "https://tspay.uz/api/v1/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://tspay.uz/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
