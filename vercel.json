{
  "rewrites": [
    {
      "source": "/api-tspay/(.*)",
      "destination": "https://tspay.uz/api/v1/$1"
    },
    {
      "source": "/((?!assets/|logo\\.svg|logo\\.png|manifest\\.json|sw\\.js|robots\\.txt|sitemap\\.xml|.*\\.ico|.*\\.png|.*\\.jpg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/logo.svg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}